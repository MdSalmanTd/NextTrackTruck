# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=tracktruck

# Authentication
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# API Configuration
API_TIMEOUT=30000

# Optional: Logging
LOG_LEVEL=debug
